# Public storefront origin used for canonical URLs and browser-visible links.
# NEXT_PUBLIC_* values are embedded at Next.js build time.
# Changing these values for Docker deployments requires rebuilding the image.
NEXT_PUBLIC_APP_URL=http://localhost:3200

# Backend API base URL consumed by the browser and server-rendered storefront code.
# Include the /api prefix when the backend is mounted there.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# Razorpay browser key id. Use a test key outside production.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_replace_me
